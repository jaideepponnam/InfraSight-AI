# Development: Vite proxies /api to this target.
# Render production: set https://api.jaideepponnam.com; browser calls it directly.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Browser-visible public/demo READ credential, NOT a confidential secret.
# Match the dedicated backend API_READ_KEY; never use API_ADMIN_KEY here.
# VITE_* values are public. Never configure database, Groq, or admin credentials.
VITE_API_READ_KEY=
