# Copy to .env and replace the password before starting PostgreSQL.
APP_NAME=InfraSight-AI
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=infrasight
POSTGRES_USER=infrasight
POSTGRES_PASSWORD=replace-with-a-local-password
# URL-encode special characters in the password in this URL.
DATABASE_URL=postgresql+psycopg://infrasight:replace-with-a-local-password@localhost:55432/infrasight
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000

# One-cycle micro-batch ingestion; a long-running worker is a later milestone.
TELEMETRY_INTERVAL_SECONDS=30
SIMULATOR_SERVER_COUNT=75
SIMULATOR_SEED=7
SIMULATOR_MALFORMED_RATE=0.01
ETL_BATCH_SIZE=500
ETL_OVERLAP_SECONDS=60
ETL_INITIAL_LOOKBACK_SECONDS=120
ETL_MAX_WINDOW_SECONDS=3600
ETL_SOURCE_MAX_ATTEMPTS=3
ETL_RETRY_BASE_SECONDS=0.25
ETL_RETRY_MAX_SECONDS=5
# Optional: install the host extra, then explicitly enable collection.
HOST_ENABLED=false
HOST_SOURCE_ID=host-local
HOST_EXTERNAL_SERVER_ID=local-host
HOST_REGION_CODE=local
HOST_ENVIRONMENT=dev
HOST_DISK_PATH=.
HOST_SAMPLE_SECONDS=1

# Analytics service defaults; views expose an explicit 120-second wall-clock default.
ANALYTICS_FRESHNESS_SECONDS=120
ANALYTICS_MAX_WINDOW_DAYS=7
ANALYTICS_MAX_RESULTS=100

# Business endpoints require X-API-Key; general ETL also requires X-Admin-Key.
# The narrow simulator-only demo ETL route permits the public/demo read key.
API_READ_KEY=replace-with-a-long-random-read-key
API_ADMIN_KEY=replace-with-a-different-long-random-admin-key
ETL_API_MAX_WINDOW_SECONDS=600

# Groq credentials are supplied by environment; leave blank until configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RESULT_ROWS=20

# Streamlit sends these keys server-side only. Match the corresponding FastAPI keys.
INFRASIGHT_API_BASE_URL=http://127.0.0.1:8000
INFRASIGHT_API_KEY=
INFRASIGHT_ADMIN_KEY=

# Exact browser origins only; production Render uses only the custom frontend origin.
CORS_ALLOWED_ORIGINS=["https://jaideepponnam.com","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:4173","http://127.0.0.1:4173"]
# Neon: paste the direct (not -pooler) URL with sslmode=require.
# postgres:// and postgresql:// URLs are normalized to the existing psycopg driver.
